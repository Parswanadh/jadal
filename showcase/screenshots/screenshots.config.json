    { "path": "/phone", "name": "phone", "viewport": "desktop", "fullPage": false },
    { "path": "/phone", "name": "phone-mobile", "viewport": "mobile", "fullPage": false },
    { "path": "/demo", "name": "demo", "viewport": "desktop", "fullPage": true }
  ]
