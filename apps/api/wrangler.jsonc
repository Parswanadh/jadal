{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jadal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jadal-db",
      "database_id": "2d6a9557-c9f8-4536-b723-26a64380078c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "7db113dec0114f389553f674580a79a5"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOUND",
        "queue": "jadal-outbound"
      }
    ],
    "consumers": [
      {
        "queue": "jadal-outbound",
        "max_retries": 5,
        "dead_letter_queue": "jadal-outbound-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "jadal-urgent-request-workflow",
      "binding": "URGENT_REQUEST_WORKFLOW",
      "class_name": "UrgentRequestWorkflow"
    },
    {
      "name": "jadal-call-campaign-workflow",
      "binding": "CALL_CAMPAIGN_WORKFLOW",
      "class_name": "CallCampaignWorkflow"
    }
  ],
  "vars": {
    "ENVIRONMENT": "demo",
    "DEMO_MODE": "1",
    "REAL_TELEPHONY": "false"
  },
  "triggers": {
    "crons": [
      "30 0 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
