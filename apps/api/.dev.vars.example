# Jadal API — local development variables (example).
#
# Copy to `apps/api/.dev.vars` and fill in real values. `apps/api/.dev.vars` is gitignored and must
# never be committed. Every value below is optional: with an empty file the API runs the full
# offline demo path (deterministic core, event log, simulated phone) and places no network calls.
#
# `DB`, `CACHE`, `OUTBOUND` and `ASSETS` are Wrangler *bindings*, not variables: `wrangler dev`
# provisions local D1, KV, Queue and static-asset emulation from `wrangler.jsonc`, so they are
# intentionally not listed here.

# Run the offline demo path (default `true`). Set `false` to opt into live providers.
DEMO_MODE=true

# Free-form deployment label surfaced in logs/health, e.g. `development`, `preview`, `production`.
ENVIRONMENT=development

# Cloudflare AI Gateway base URL. When set, provider calls are prefixed with it for caching,
# logging and rate limits (ADR-001). Example:
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>
AI_GATEWAY_URL=

# --- System 1 (Jev / Laya / rules) ----------------------------------------------------------
# Which System-1 decision provider to use: `laya`, `jev`, `rules` or `auto`.
# Unset/blank => `auto`: Laya (local, Telugu-native) first, then Jev, then the Telugu keyword rules.
# An unrecognised spelling degrades to `rules` (offline, no network). `rules` never touches the
# network. Whatever runs, the decision carries source=laya|jev|rules, so a fallback is never silent.
SYSTEM1_PROVIDER=

# Local Laya sidecar base URL (lane L builds `services/laya`, `POST /decide`). Unset => Laya is
# skipped in the chain. Example: http://127.0.0.1:8099/decide
LAYA_ENDPOINT=

# Deadline for one Laya call, in milliseconds. Unset => 4000. Values outside 100..15000 are clamped.
LAYA_TIMEOUT_MS=

# OpenRouter key. Powers Jev (System 1) and the System-2 agent prose. Unset => Jev is skipped.
OPENROUTER_API_KEY=

# OpenRouter chat-model slug for the System-2 agent prose. Unset => `openai/gpt-4o-mini`.
OPENROUTER_MODEL=

# Maximum OpenRouter spend in USD. Unset => no limit. When reached, System-1 falls back to rules.
OPENROUTER_SPEND_LIMIT_USD=5

# Jev route slug on OpenRouter's typed Decisions API. Unset => `typesafe/jev-1.13`.
# `~typesafe/jev-latest` floats to the newest Jev release; pin a version when urgency thresholds
# were tuned against it. NOT `typesafe/jev-router`: that slug is an OpenRouter chat-model router
# (it returns generated text), not a Decisions model, and the Decisions API rejects it.
JEV_MODEL=

# Deadline for one Jev Decisions call, in milliseconds. Unset => 4000. Values outside 250..15000 are
# clamped. On timeout the classifier falls back to the next provider and reports source=jev only if
# Jev actually answered.
JEV_TIMEOUT_MS=

# Sarvam AI key for Telugu speech-to-text (`saaras`) and text-to-speech (`bulbul`).
# Unset => the simulated phone shows text and skips audio.
SARVAM_API_KEY=

# Optional Sarvam `bulbul` speaker voice. Unset => the module default (`shubh`).
SARVAM_TTS_SPEAKER=

# Optional Deepgram key. Only used as a speech-to-text fallback when Sarvam cannot transcribe
# (`nova-3`, `language=te`).
DEEPGRAM_API_KEY=

# Twilio trial credentials. All four are required before real PSTN calls are attempted:
# the account, the auth token, the caller ID and a public origin Twilio can reach for webhooks.
# The caller ID is `TWILIO_FROM_NUMBER` (the name `src/telephony` reads), not `TWILIO_FROM`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional live-demo redirect. The seeded farmers carry placeholder Mobiles that cannot receive a
# real call, so set this to one or more real E.164 numbers (comma-separated) to route outbound
# calls to a reachable handset instead. One recipient always maps to the same target. Unset =>
# calls go to the farmer's own number. Only used when REAL_TELEPHONY=true.
TWILIO_FORWARD_TO=

# Public https origin for the Twilio webhooks, no trailing path. Locally this is a tunnel, e.g.
# `cloudflared tunnel --url http://localhost:8788` printed as https://<name>.trycloudflare.com;
# in production it is the deployed Worker origin. Must match the host Twilio signs, exactly.
PUBLIC_BASE_URL=

# Meta WhatsApp Cloud API credentials. Fallback is the in-app WhatsApp drawer.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Explicit opt-in for real PSTN calls (`true`/`1`). Requires a full Twilio credential set above;
# otherwise the simulated phone is used. Keep `false` in every demo.
REAL_TELEPHONY=false

# LOCAL TESTS ONLY: `1` disables X-Twilio-Signature validation so a webhook can be replayed with curl.
# Never set this on a deployed Worker.
# SKIP_TWILIO_SIGNATURE=1

# --- Failproof observability ---------------------------------------------------------------
# When FAILPROOF_TRACE=1, every API request is traced as a Failproof session and POSTed to the
# Failproof ingest endpoint using FAILPROOF_API_KEY. Unset/blank => tracing is off.
FAILPROOF_API_KEY=
FAILPROOF_TRACE=
