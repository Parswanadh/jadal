# Jadal web app configuration.
# Copy to `.env.local` and adjust. Every value here is optional: with no file at
# all the app runs in mock mode with the documented sign-in passwords.
#
# These are configuration names, not secrets. The role gate is client-side by
# decision for this local build; there is no user table and no hashed password.

# Data source. Leave unset (or 1) for the in-browser mock; set 0 to call the API.
VITE_MOCK=1

# Base URL of the API when VITE_MOCK=0, e.g. http://localhost:8787.
# Empty means same origin (the Vite dev proxy).
VITE_API_BASE=

# Sign-in passwords, one per role. There is no self sign-up: whoever runs this
# copy sets both. The values below are the non-secret DEFAULTS and are safe to
# commit; change them before sharing a build.
VITE_FARMER_PASSWORD=farmer123
VITE_COORDINATOR_PASSWORD=coordinator123
