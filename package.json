{
  "name": "jadal-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "dev": "pnpm -r --parallel dev",
    "deploy": "pnpm --filter api deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.8.2"
  }
}
